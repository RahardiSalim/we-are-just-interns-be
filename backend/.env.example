# Local development against the Firebase emulators (start them from firebase/ with `firebase emulators:start`).
GCP_PROJECT=demo-gosafe
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
ENABLE_DEV_ROUTES=true
# AI review of flagged rides. Leave empty to use the rule-based review.
# Sahabat-AI on any OpenAI-compatible server (vLLM, Ollama, hosted):
LLM_BASE_URL=
LLM_API_KEY=
# Fallback: a Gemini API key from Google AI Studio.
GEMINI_API_KEY=
# Decision emails to the rider and driver. Leave SMTP_HOST empty to log them instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="GoSafe <no-reply@gosafe.test>"
# Password for the 6 seeded demo accounts (<uid>@gosafe.test). Emulator only; use your own for a real project.
SEED_PASSWORD=gosafe-demo
