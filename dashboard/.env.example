# Copy to .env.local. Values come from Firebase console > Project settings > Your apps > Web app.
# These are public web config, not secrets. Set the same names in Vercel > Settings > Environment Variables.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-gosafe
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_API_URL=http://localhost:8000
# "true" to use the local Firebase emulators (any API key works then)
NEXT_PUBLIC_USE_EMULATORS=true
