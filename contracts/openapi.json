  "components": {
    "schemas": {
      "Consent": {
        "properties": {
          "audioConsent": {
            "type": "boolean",
            "title": "Audioconsent"
          }
        },
        "type": "object",
        "required": [
          "audioConsent"
        ],
        "title": "Consent"
      },
      "CreateIncident": {
        "properties": {
          "tripId": {
            "type": "string",
            "title": "Tripid"
          },
          "trigger": {
            "type": "string",
            "enum": [
              "sos",
              "manual_unsafe",
              "auto"
            ],
            "title": "Trigger"
          },
          "windowStart": {
            "type": "string",
            "format": "date-time",
            "title": "Windowstart"
          },
          "windowEnd": {
            "type": "string",
            "format": "date-time",
            "title": "Windowend"
          },
          "deviceTranscript": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/TranscriptLine"
                },
                "type": "array",
                "maxItems": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Devicetranscript"
          },
          "deviceLabel": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "normal",
                  "uncomfortable",
                  "sexual_harassment",
                  "threat"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Devicelabel"
          },
          "deviceScore": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Devicescore"
          }
        },
        "type": "object",
        "required": [
          "tripId",
          "trigger",
          "windowStart",
          "windowEnd"
        ],
        "title": "CreateIncident"
      },
      "Decision": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "dismiss",
              "warn_driver",
              "suspend_driver",
              "contact_rider"
            ],
            "title": "Action"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "Decision"
      },
      "EventBatch": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/TripEvent"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "events"
        ],
        "title": "EventBatch"
      },
      "FcmToken": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "FcmToken"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Marker": {
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0.0,
            "title": "At"
          },
          "kind": {
            "type": "string",
            "enum": [
              "warning",
              "high",
              "sos",
              "manual_unsafe"
            ],
            "title": "Kind"
          },
          "label": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "normal",
                  "uncomfortable",
                  "sexual_harassment",
                  "threat"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "score": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "at",
          "kind"
        ],
        "title": "Marker",
        "description": "A moment in the full recording an agent should check."
      },
      "Recording": {
        "properties": {
          "durationSec": {
            "type": "number",
            "maximum": 21600.0,
            "minimum": 0.0,
            "title": "Durationsec"
          },
          "contentType": {
            "type": "string",
            "enum": [
              "audio/aac",
              "audio/mp4",
              "audio/ogg",
              "audio/wav"
            ],
            "title": "Contenttype"
          },
          "markers": {
            "items": {
              "$ref": "#/components/schemas/Marker"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Markers"
          },
          "transcript": {
            "items": {
              "$ref": "#/components/schemas/Utterance"
            },
            "type": "array",
            "maxItems": 5000,
            "title": "Transcript",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "durationSec",
          "contentType",
          "markers"
        ],
        "title": "Recording"
      },
      "Reply": {
        "properties": {
          "answer": {
            "type": "string",
            "enum": [
              "ok",
              "need_help"
            ],
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "Reply"
      },
      "StartTrip": {
        "properties": {
          "orderId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
